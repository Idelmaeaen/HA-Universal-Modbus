  "services": {
    "write_register": {
      "name": "写入寄存器",
      "description": "向 Universal Modbus 集线器的保持寄存器写入一个或多个原始值。单个值使用 FC06（写单个寄存器），值列表使用 FC16（写多个寄存器）。无需预先配置实体。",
      "fields": {
        "hub": {
          "name": "集线器",
          "description": "集线器名称（如 light_modbus_hub）或配置条目 ID。"
        },
        "address": {
          "name": "地址",
          "description": "起始寄存器地址（0-65535）。"
        },
        "slave": {
          "name": "从站",
          "description": "Modbus 单元/从站 ID（0-255），默认为集线器的单元 ID。"
        },
        "value": {
          "name": "值",
          "description": "单个值（0-65535），或写入连续寄存器的值列表。"
        }
      }
    },
    "export_profile": {
      "name": "导出配置档案",
      "description": "将当前 Modbus 实体配置档案导出为可复用的 JSON 文件。",
